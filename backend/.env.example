# Copy this file to .env and fill in real values before running

PORT=5000

# Comma separated list of frontend origins allowed to call this API
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# Secret key required in the "x-admin-key" header to view enquiries
ADMIN_KEY=change-this-to-a-strong-secret

# Get these from https://dashboard.razorpay.com  (Settings -> API Keys)
# Start with TEST keys (they start with rzp_test_) until you are ready to go live
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Default registration fee in INR (rupees) if the frontend does not send one
DEFAULT_FEE_INR=500

# Email alerts for new enquiries (optional — leave blank to skip)
# Use a Gmail "App Password", not your normal Gmail password:
# https://myaccount.google.com/apppasswords
EMAIL_USER=youracademy@gmail.com
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx
# Where enquiry alerts should be sent (defaults to EMAIL_USER if left blank)
NOTIFY_EMAIL=youracademy@gmail.com
