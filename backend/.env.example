# Copy this file to .env and fill in real values before running

PORT=5000

# Comma separated list of frontend origins allowed to call this API.
# Include BOTH your Netlify URL and your real domain (once connected):
CORS_ORIGIN=https://aaravv.netlify.app,https://www.everestaviationacademy.com

# ── Database (IMPORTANT for a live site) ──────────────────────────────
# Without this, data is saved to local JSON files, which get WIPED whenever
# Render restarts your app (free tier restarts often). Set this to keep your
# enquiries and payments permanently safe.
#
# Get a free MongoDB Atlas cluster (takes ~5 minutes):
# 1. https://www.mongodb.com/cloud/atlas/register — sign up free
# 2. Create a free "M0" cluster
# 3. Database Access → Add a database user (username + password)
# 4. Network Access → Add IP Address → "Allow access from anywhere" (0.0.0.0/0)
# 5. Clusters → Connect → Drivers → copy the connection string and paste below
#    (replace <password> with your database user's password)
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/everest?retryWrites=true&w=majority

# Secret key required in the "x-admin-key" header to view enquiries
ADMIN_KEY=change-this-to-a-strong-secret

# Get these from https://dashboard.razorpay.com  (Settings -> API Keys)
# Start with TEST keys (they start with rzp_test_) until you are ready to go live
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Default registration fee in INR (rupees) if the frontend does not send one
DEFAULT_FEE_INR=500

# Email alerts for new enquiries (optional — leave blank to skip)
# Use a Gmail "App Password", not your normal Gmail password:
# https://myaccount.google.com/apppasswords
EMAIL_USER=youracademy@gmail.com
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx
# Where enquiry alerts should be sent (defaults to EMAIL_USER if left blank)
NOTIFY_EMAIL=youracademy@gmail.com
